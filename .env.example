# Infrastructure (docker compose)
DATABASE_URL=postgres://abotica:abotica@localhost:54329/abotica
REDIS_URL=redis://localhost:63799

# Web
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Other public origins allowed to sign in and to receive MCP OAuth callbacks, comma separated
# (e.g. an ngrok tunnel to the dev server)
# TRUSTED_ORIGINS=https://your-name.ngrok-free.dev
# Allow creating the (single) account. It closes on its own after the first sign-up.
ALLOW_SIGNUP=true
# When set, creating the account also needs this code (install.sh generates one): on a public
# server nobody else can claim the instance first. openssl rand -hex 24
# SETUP_CODE=

# Vault: AES-256-GCM key for secrets stored in the DB. openssl rand -base64 32
VAULT_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot
TELEGRAM_ALLOWED_USER_IDS=
# Chat where notifications go (your user id, or a forum group id)
TELEGRAM_NOTIFY_CHAT_ID=

# Ollama (local models; API keys are set in Settings > AI providers)
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: openai (text-embedding-3-small @768 dims) or ollama (nomic-embed-text)
EMBEDDING_PROVIDER=openai

# Worker: agent runs executed in parallel (default 4)
# RUN_CONCURRENCY=4
# Worker shutdown (restart, update): milliseconds the runs in progress get to finish before they are
# stopped with their partial answers saved (default 30000). Keep it below the worker's
# stop_grace_period in docker-compose.prod.yml (60 s); docker-compose.yml sets 3000 for tsx watch.
# WORKER_SHUTDOWN_DRAIN_MS=30000

# Task attachments directory (default: apps/web/.data/uploads).
# Required in production without Docker: an absolute path outside the repo, e.g. /var/lib/abotica/uploads
# UPLOADS_DIR=

# Sandbox (agents' workspaces and stdio MCP servers): a Docker container per workspace. Both
# docker-compose files set these for the worker; unset SANDBOX_DOCKER_HOST means no sandbox.
# Docker Engine API for the sandbox containers, e.g. tcp://docker-proxy:2375
# SANDBOX_DOCKER_HOST=
# Internal Docker network shared by the sandbox containers and the worker (default abotica-sandbox)
# SANDBOX_DOCKER_NETWORK=abotica-sandbox
# Image of the sandbox containers (default abotica-sandbox:latest)
# SANDBOX_IMAGE=abotica-sandbox:latest

# Previews of what agents make (mockups, documents, apps they start), each at <code>.<host of this URL>.
# In production: a wildcard DNS name routed to the worker's port 3100 (see deploy/Caddyfile), e.g.
# https://preview.abotica.example.com. Default: http://preview.localhost:3100 (local development).
# PREVIEW_URL=
