# Infrastructure (docker compose)
DATABASE_URL=postgres://abotica:abotica@localhost:54329/abotica
REDIS_URL=redis://localhost:63799
# Database connections per process (the web app and the worker each have their own pool; default 10)
# DATABASE_POOL_MAX=10

# Web
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Other public origins allowed to sign in and to receive MCP OAuth callbacks, comma separated
# (e.g. an ngrok tunnel to the dev server)
# TRUSTED_ORIGINS=https://your-name.ngrok-free.dev
# Allow creating the (single) account. It closes on its own after the first sign-up.
ALLOW_SIGNUP=true
# When set, creating the account also needs this code (install.sh generates one): on a public
# server nobody else can claim the instance first. openssl rand -hex 24
# SETUP_CODE=

# Vault: AES-256-GCM key for secrets stored in the DB. openssl rand -base64 32
VAULT_KEY=

# The host machine as a container reaches it. Both docker-compose files set it for their containers,
# so localhost addresses entered in the app (the Ollama server) reach this machine; unset elsewhere.
# The Ollama address, the embedding provider and the runs executed in parallel are set in the app.
# HOST_GATEWAY=host.docker.internal

# Worker shutdown (restart, update): milliseconds the runs in progress get to finish before they are
# stopped with their partial answers saved (default 30000). Keep it below the worker's
# stop_grace_period in docker-compose.prod.yml (60 s); docker-compose.yml sets 3000 for tsx watch.
# WORKER_SHUTDOWN_DRAIN_MS=30000

# Task attachments directory (default: apps/web/.data/uploads).
# Required in production without Docker: an absolute path outside the repo, e.g. /var/lib/abotica/uploads
# UPLOADS_DIR=

# Where the worker keeps the built-in embedding model it downloads once, about 280 MB (default:
# apps/worker/.data/models). The compose files set /data/models, a volume kept across updates.
# MODELS_DIR=

# Sandbox (agents' workspaces and stdio MCP servers): a Docker container per workspace. Both
# docker-compose files set these for the worker; unset SANDBOX_DOCKER_HOST means no sandbox.
# Docker Engine API for the sandbox containers, e.g. tcp://docker-proxy:2375
# SANDBOX_DOCKER_HOST=
# Internal Docker network shared by the sandbox containers and the worker (default abotica-sandbox)
# SANDBOX_DOCKER_NETWORK=abotica-sandbox
# Image of the sandbox containers (default abotica-sandbox:latest)
# SANDBOX_IMAGE=abotica-sandbox:latest

# Previews of what agents make (mockups, documents, apps they start), each at <code>.<host of this URL>.
# In production: a wildcard DNS name routed to the worker's preview port (see deploy/Caddyfile), e.g.
# https://preview.abotica.example.com. Default: http://preview.localhost:3100 (local development).
# How long preview links stay open is set in the app (Settings > Previews).
# PREVIEW_URL=
# Port the worker serves previews on (default 3100). The compose files publish it on 127.0.0.1 and
# point Caddy at it; locally, change PREVIEW_URL to the same port.
# PREVIEW_PORT=3100

# Model catalog (prices, context windows) in the models.dev format, refreshed every 12 hours.
# CATALOG_URL=https://models.dev/api.json
# Telegram Bot API, for a local Bot API server or a proxy. The bot itself is set up in the app
# (Settings > Telegram).
# TELEGRAM_API_URL=https://api.telegram.org

# Updates: the running release (set in the published images and by the installers) and the GitHub
# repository whose releases the update check compares it with.
# ABOTICA_VERSION=
# ABOTICA_RELEASES_REPO=codevision-ro/abotica

# Production with docker-compose.prod.yml only (read by compose, not by the app):
# ABOTICA_DOMAIN=abotica.example.com   the domain the bundled Caddy serves (with COMPOSE_PROFILES=https)
# COMPOSE_PROFILES=https,ollama        optional services: https (Caddy), ollama
# POSTGRES_PASSWORD=                   the database password (default abotica)
# WEB_PORT=3000                        the web app's port on 127.0.0.1
# SANDBOX_APT_PACKAGES=                more Debian packages for every workspace, space separated
# BACKUP_INTERVAL_SECONDS=86400        how often the backup service runs (default once a day)
# BACKUP_RETENTION_DAYS=14             days the backups in ./backups are kept

# Older installs had the Telegram bot (TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_USER_IDS,
# TELEGRAM_NOTIFY_CHAT_ID), OLLAMA_BASE_URL, EMBEDDING_PROVIDER and RUN_CONCURRENCY here. The worker
# copies them into the app once, at its first start after the update; then the lines can go.

# End-to-end checks read E2E_PROVIDER, E2E_MODEL, E2E_GITHUB_TOKEN and E2E_ONLY (CONTRIBUTING.md, packages/core/scripts).
