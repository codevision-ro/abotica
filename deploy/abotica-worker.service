# Example only. Copy to /etc/systemd/system/, adjust User and WorkingDirectory, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now abotica-worker
[Unit]
Description=Abotica worker (agent runs, Telegram, schedules)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=abotica
WorkingDirectory=/srv/abotica
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm start:worker
# On stop the worker gives the runs in progress WORKER_SHUTDOWN_DRAIN_MS (default 30 s) to finish,
# then stops the rest and saves what they did so far; keep this longer than the drain.
TimeoutStopSec=60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
