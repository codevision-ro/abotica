{
  "name": "@abotica/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./auth-schema": "./src/schema/auth.ts",
    "./orm": "./src/orm.ts",
    "./avatar": "./src/avatar.ts",
    "./seed-permissions": "./src/seed-permissions.ts"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "studio": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc",
    "lint": "eslint"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  }
}
